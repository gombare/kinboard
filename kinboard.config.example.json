    "startDate": "2026-01-05",
    "weeks": [
      {
        "mon": ["Pasta with beans", "Chicken salad"],
        "tue": ["Cheese omelette", "Fish"],
        "wed": ["Beef stew", "Lentil soup"],
        "thu": ["Fish", "Eggs"],
        "fri": ["Chickpeas", "Chicken"],
        "sat": ["Pizza", "Cheese board"],
        "sun": ["Roast", "Soup"]
      }
    ],
    "overrides": { "2026-12-25": "Christmas lunch at grandma's" }
  },

  "medications": {
    "items": [
      { "who": "Anna", "name": "Vitamin D", "times": ["08:00"] },
      { "who": "Tom", "name": "Antibiotic", "times": ["08:00", "20:00"], "until": "2026-11-05" }
    ]
  },

  "waste": {
    "from": 20,
    "until": 6,
    "schedule": {
